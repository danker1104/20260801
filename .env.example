# 뭐 먹을래? 개발 환경 변수 (템플릿)
# 이 파일을 .env 파일로 복사하고 실제 값으로 채워주세요
# .gitignore에 .env가 추가되어 있으므로 Git에 커밋되지 않습니다

# ===== SK Open API (T-Map POI 검색) =====
SK_TMAP_API_KEY=YOUR_SK_TMAP_API_KEY_HERE

# ===== 데이터베이스 =====
# 개발 환경: SQLite 사용
DATABASE_URL=sqlite:///./sg_food.db

# ===== FastAPI 서버 =====
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# 개발 모드
DEBUG=True

# 인증 토큰 서명 키 (운영에서는 긴 무작위 값으로 설정)
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
AUTH_TOKEN_TTL_SECONDS=86400

# ===== CORS 설정 =====
FRONTEND_URL=http://localhost:3000

# ===== 카카오 Maps API =====
# 카카오디벨로퍼스(https://developers.kakao.com)에서 발급받은 JavaScript 키
# 로컬 개발: http://localhost:3000 도메인에서 사용
# 프론트엔드 frontend/js/config.js 파일의 KAKAO_MAPS_API_KEY와 동일한 값이어야 합니다
KAKAO_MAPS_API_KEY=YOUR_KAKAO_JAVASCRIPT_API_KEY_HERE

# ===== Gemini API =====
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# ===== 리뷰 이벤트성 스파이크 필터 =====
REVIEW_EVENT_FILTER_ENABLED=true
REVIEW_SPIKE_WINDOW_HOURS=24
REVIEW_SPIKE_MIN_COUNT=12
REVIEW_SPIKE_MULTIPLIER=2.5
REVIEW_EVENT_AI_CONFIDENCE_THRESHOLD=0.6

